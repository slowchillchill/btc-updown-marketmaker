{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "execution_feedback_labels.schema.json",
  "title": "ExecutionFeedbackLabel",
  "type": "object",
  "required": [
    "decision_id",
    "paper_or_live",
    "market_id",
    "token_id",
    "side",
    "price",
    "size",
    "tte_ms",
    "order_type",
    "model_version",
    "feature_schema_version",
    "feature_hash",
    "causal_cutoff_ts",
    "book_hash_at_decision",
    "outcome",
    "label_maturity_ts",
    "authority_source",
    "settlement_source",
    "censoring_reason",
    "online_rule_version"
  ],
  "properties": {
    "decision_id": {"type": "string"},
    "paper_or_live": {"enum": ["paper", "live", "simulation", "no_live_rehearsal"]},
    "market_id": {"type": "string"},
    "token_id": {"type": "string"},
    "side": {"enum": ["BUY", "SELL", "NO_QUOTE", "NO_SUBMIT"]},
    "price": {"type": ["number", "null"], "minimum": 0, "maximum": 1},
    "size": {"type": ["number", "null"], "minimum": 0},
    "tte_ms": {"type": ["integer", "null"]},
    "order_type": {"type": ["string", "null"]},
    "model_version": {"type": "string"},
    "feature_schema_version": {"type": "string"},
    "feature_hash": {"type": "string"},
    "causal_cutoff_ts": {"type": "string"},
    "book_hash_at_decision": {"type": ["string", "null"]},
    "outcome": {
      "enum": [
        "reject",
        "timeout_unknown",
        "fill_partial",
        "fill_full",
        "cancelled",
        "trading_exit",
        "hold_to_resolution",
        "resolved_detected",
        "redeem_after_resolved",
        "settled_pnl",
        "no_quote_opportunity",
        "no_submit_opportunity"
      ]
    },
    "label_maturity_ts": {"type": "string"},
    "authority_source": {"type": "string"},
    "settlement_source": {"type": ["string", "null"]},
    "censoring_reason": {"type": ["string", "null"]},
    "online_rule_version": {"type": "string"}
  },
  "additionalProperties": false
}
