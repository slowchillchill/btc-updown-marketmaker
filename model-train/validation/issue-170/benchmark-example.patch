+// 单列诊断在 wall 计时外读取全进程累计 CPU，包含本进程全部线程。
+fn process_cpu_ns()->u128 {
+    let mut value=libc::timespec {tv_sec:0,tv_nsec:0};
+    // 仅基准使用系统 CPU 时钟；指针指向本地完整 timespec，返回状态必须成功。
+    assert_eq!(unsafe {libc::clock_gettime(libc::CLOCK_PROCESS_CPUTIME_ID,&mut value)},0);
+    value.tv_sec as u128*1_000_000_000+value.tv_nsec as u128
+}
