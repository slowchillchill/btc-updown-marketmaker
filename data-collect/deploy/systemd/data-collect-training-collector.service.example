[Unit]
Description=data-collect training collector
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/btc-updown-marketmaker
Environment=DATA_COLLECT_RUNTIME_MODE=live
Environment=DATA_COLLECT_SYSTEMD_UNIT=data-collect-training-collector.service
Environment="DATA_COLLECT_SYSTEMD_RESTART_POLICY=Restart=always;RestartPreventExitStatus=75"
ExecStart=/usr/bin/env bash -lc 'exec %h/btc-updown-marketmaker/data-collect/current/bin/train-data-collect-ver1-0 --dataset-root %h/btc-updown-marketmaker/datasets --run-id training-longrun-$(date -u +%%Y%%m%%dT%%H%%M%%SZ) --collector-region eu-west-1 --run-forever --retention-delete-mode enabled --retention-threshold-bytes 50000000000'
# Manual review one-market command:
# ExecStart=/usr/bin/env bash -lc 'exec %h/btc-updown-marketmaker/data-collect/current/bin/data-collect-training-collector --dataset-root %h/btc-updown-marketmaker/datasets --run-id manual-review-$(date -u +%%Y%%m%%dT%%H%%M%%SZ) --collector-region eu-west-1 --stop-after-complete-polymarket-market 1'
Restart=always
RestartSec=10
RestartPreventExitStatus=75
TimeoutStopSec=90

[Install]
WantedBy=default.target
