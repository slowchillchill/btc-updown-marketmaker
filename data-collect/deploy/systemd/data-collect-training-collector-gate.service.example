[Unit]
Description=data-collect training collector 2h gate
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/btc-updown-marketmaker
Environment=DATA_COLLECT_RUNTIME_MODE=live
Environment=DATA_COLLECT_SYSTEMD_UNIT=data-collect-training-collector-gate.service
Environment=DATA_COLLECT_SYSTEMD_RESTART_POLICY=Restart=no
ExecStart=/usr/bin/env bash -lc 'exec %h/btc-updown-marketmaker/data-collect/current/bin/data-collect-training-collector --dataset-root %h/btc-updown-marketmaker/datasets --run-id training-systemd-gate-$(date -u +%%Y%%m%%dT%%H%%M%%SZ) --collector-region eu-west-1 --max-runtime-secs 7200 --retention-delete-mode dry-run'
Restart=no
TimeoutStopSec=90

[Install]
WantedBy=default.target
